{
  "name": "dong-a-frontend",
  "version": "2.0.0",
  "description": "App Hào Khí Đông A (Expo React Native): Android, iOS và web",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export -p web && node ../scripts/write-build-info.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.9",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.13",
    "leaflet": "^1.9.4",
    "lucide-react-native": "^1.61.0",
    "motion": "^14.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "socket.io-client": "^4.8.4",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.3.0",
    "@types/three": "0.160.0",
    "typescript": "~6.0.3"
  }
}
