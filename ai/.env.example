# Dịch vụ AI Python – sao chép thành ai/.env khi chạy trên máy. Không commit khóa thật.
# Google Gemini (lấy miễn phí tại https://aistudio.google.com/). Để trống: dùng câu trả lời từ kho tri thức (RAG).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Hugging Face (dự phòng khi Gemini lỗi): https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Đặt giống AI_SERVICE_TOKEN của backend NestJS; để trống khi chạy thử trên máy
AI_SERVICE_TOKEN=

# Khóa ký file Excel mẫu (HMAC-SHA256), chuỗi ngẫu nhiên dài; để trống: dùng khóa suy ra từ AI_SERVICE_TOKEN
EXCEL_SIGNING_KEY=
