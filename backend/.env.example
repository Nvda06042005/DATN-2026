# Cấu hình API Key của Google Gemini
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cấu hình Hugging Face (Mô hình Qwen2.5-7B-Instruct & BGE-M3)
# Lấy Access Token miễn phí tại: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder

# Cấu hình máy chủ
HOST=0.0.0.0
PORT=8000


# PostgreSQL Supabase - lay tai Supabase > Connect > Session pooler
# Khong commit mat khau that vao GitHub
# Backend tự chạy database/migrations/*.sql khi khởi động với DATABASE_URL.
# Chỉ chạy file chưa có trong app_schema_migrations; lỗi migration sẽ dừng khởi động.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Đăng nhập & tài khoản
# Khóa ký phiên đăng nhập: chuỗi ngẫu nhiên dài, giữ bí mật (python -c "import secrets; print(secrets.token_urlsafe(48))")
AUTH_SECRET_KEY=
TOKEN_TTL_HOURS=12
# Tài khoản quản trị được tạo ở lần chạy đầu tiên – đăng nhập tại trang /admin của frontend.
# Khi triển khai thật nên đặt mật khẩu riêng thay cho mặc định admin@123.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
# Đá quý tặng học sinh mới
STARTING_GEMS=100
# Không có DATABASE_URL -> tài khoản lưu ở SQLite cục bộ (đường dẫn dưới đây)
# USERS_DB_PATH=../database/data/users.db
