# Backend NestJS – sao chép thành backend/.env khi chạy trên máy. Không commit file .env hay mật khẩu thật.
PORT=8000

# PostgreSQL Supabase: Supabase > Connect > Session pooler.
# Backend tự chạy database/migrations/*.sql khi khởi động (chỉ file chưa có trong app_schema_migrations);
# lỗi migration sẽ dừng khởi động. Chạy tay: npm run build && npm run migrate -- status
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Khóa ký JWT: chuỗi ngẫu nhiên dài, giữ bí mật
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET_KEY=
TOKEN_TTL_HOURS=12

# Tài khoản quản trị tổng tạo ở lần chạy đầu tiên (đăng nhập tại /root-system-admin). Triển khai thật nên đổi mật khẩu.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
# Ấn Tín tặng học sinh mới
STARTING_GEMS=100

# Dịch vụ AI Python (thư mục ai/): chatbot RAG, BKT, soạn đề, soạn truyện
AI_SERVICE_URL=http://localhost:8001
# Trùng với AI_SERVICE_TOKEN của dịch vụ AI để chỉ backend gọi được
AI_SERVICE_TOKEN=

# Cấp tài khoản từ file Excel: tên miền của tên đăng nhập, địa chỉ website ghi trong thư
ACCOUNT_DOMAIN=donga.local
APP_URL=https://datn-2026-indol.vercel.app

# Gửi thư thông tin đăng nhập (Nodemailer). Để trống: thư nằm chờ trong hàng đợi, quản trị tải CSV để phát tay.
#   SMTP_URL=smtps://user:app-password@smtp.gmail.com:465   (hoặc dùng SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS)
SMTP_URL=
MAIL_FROM=Đông A EDU <no-reply@donga.local>
# Chạy thử không gửi thư thật: MAIL_TRANSPORT=json (ghi thư ra bộ nhớ); MAIL_WORKER=off tắt tiến trình gửi nền
MAIL_TRANSPORT=
