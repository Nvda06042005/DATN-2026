{
  "name": "dong-a-backend",
  "version": "3.0.0",
  "private": true,
  "description": "Backend NestJS của Hào Khí Đông A: xác thực, trường, năm học, tài khoản, lớp học, kho dữ liệu lịch sử, PostgreSQL",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/setup-ai-python.mjs",
    "ai:setup": "node scripts/setup-ai-python.mjs --local",
    "ai:smoke": "node scripts/ai-smoke.mjs",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "jest --runInBand",
    "migrate": "node dist/database/migrate.cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/websockets": "^11.2.8",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.0",
    "exceljs": "4.4.0",
    "google-auth-library": "11.3.3",
    "jszip": "3.10.1",
    "nodemailer": "^10.2.1",
    "pdf-parse": "1.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.8.0"
  },
  "jest": {
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/harness.ts",
    "globalTeardown": "<rootDir>/test/harness.ts",
    "testTimeout": 60000
  }
}
